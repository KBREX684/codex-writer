# Codex Writer 环境变量配置
# 复制为 .env 并填入实际值

# OpenAI-compatible 写手模型
CODEX_WRITER_OPENAI_COMPATIBLE_BASE_URL=
CODEX_WRITER_OPENAI_COMPATIBLE_API_KEY=
CODEX_WRITER_OPENAI_COMPATIBLE_MODEL=
CODEX_WRITER_OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60
CODEX_WRITER_OPENAI_COMPATIBLE_MAX_TOKENS=4096

# Embedding 模型 (用于向量检索)
CODEX_WRITER_EMBED_BASE_URL=
CODEX_WRITER_EMBED_MODEL=
CODEX_WRITER_EMBED_API_KEY=

# Rerank 模型 (用于混合检索精排)
CODEX_WRITER_RERANK_BASE_URL=
CODEX_WRITER_RERANK_MODEL=
CODEX_WRITER_RERANK_API_KEY=

# 隐私策略
CODEX_WRITER_ALLOW_EXTERNAL_MODELS=0
CODEX_WRITER_ALLOW_FULL_MANUSCRIPT=0
CODEX_WRITER_MAX_CONTEXT_CHAPTERS_EXTERNAL=2
